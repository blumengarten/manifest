<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="halcyon"
           fetch="https://github.com/halcyonproject"
           revision="16.0" />

  <remote  name="bloom"
           fetch="https://github.com/blumengarten"
           revision="16.0" />

  <remote  name="lineage"
           fetch="https://github.com/LineageOS"
           revision="lineage-23.0" />
           
  <remote  name="halcyon-gitlab"
           fetch="https://gitlab.com/halcyonproject"
           revision="16.0" />

  <remote  name="github"
           fetch="https://github.com"
           revision="bloom" />
  
  <remote  name="gitlab"
           fetch="https://gitlab.com"
           revision="bloom" />

  <!-- Root -->
  <project path="build/make" name="build_make" remote="bloom" >
    <copyfile src="core/root.mk" dest="Makefile" />
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="build/soong" name="build_soong" remote="bloom" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <project path="bionic" name="bionic" remote="bloom" />
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" remote="bloom" />
  <project path="bootable/recovery" name="bootable_recovery" remote="bloom" />
  <project path="manifest" name="manifest" remote="bloom" />

  <!-- Device -->
  <project path="device/halcyon/sepolicy" name="device_halcyon_sepolicy" remote="bloom" />
  <project path="device/lineage/sepolicy" name="device_lineage_sepolicy" remote="bloom" />

  <!-- External -->
  <project path="external/exfatprogs" name="android_external_exfatprogs" remote="lineage" />
  <project path="external/ntfs-3g" name="android_external_ntfs-3g" remote="lineage" />
  <project path="external/setupcompat" name="external_setupcompat" remote="halcyon" />
  <project path="external/setupdesign" name="external_setupdesign" remote="halcyon" />

  <!-- Frameworks -->
  <project path="frameworks/av" name="frameworks_av" remote="bloom" />
  <project path="frameworks/base" name="frameworks_base" remote="bloom" />
  <project path="frameworks/native" name="frameworks_native" remote="bloom" />
  <project path="frameworks/opt/telephony" name="frameworks_opt_telephony" remote="bloom" />

  <!-- Hardware -->
  <project path="hardware/google/pixel" name="hardware_google_pixel" remote="bloom" />
  <project path="hardware/interfaces" name="hardware_interfaces" remote="bloom" />
  <project path="hardware/libhardware" name="hardware_libhardware" remote="bloom" />

  <!-- Kernel -->
  <project path="kernel/configs" name="kernel_configs" remote="bloom" />

  <!-- Packages Libraries -->
  <project path="packages/libraries/BlurView" name="packages_libraries_BlurView" remote="halcyon" />
  <project path="packages/libraries/preferences" name="packages_libraries_preferences" remote="halcyon" />
  <project path="packages/libraries/preference-ktx" name="packages_libraries_preference-ktx" remote="halcyon" />

  <!-- Packages -->
  <project path="packages/apps/Aperture" name="packages_apps_Aperture" remote="halcyon" />
  <project path="packages/apps/Contacts" name="packages_apps_Contacts" remote="bloom" />
  <project path="packages/apps/DeskClock" name="packages_apps_DeskClock" remote="bloom" />
  <project path="packages/apps/Dialer" name="packages_apps_Dialer" remote="bloom" />
  <project path="packages/apps/FaceUnlock" name="packages_apps_FaceUnlock" remote="gitlab" />
  <project path="packages/apps/GameSpace" name="packages_apps_GameSpace" remote="bloom" />
  <project path="packages/apps/Launcher3" name="packages_apps_Launcher3" remote="bloom" />
  <project path="packages/apps/Messaging" name="packages_apps_Messaging" remote="bloom" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" remote="bloom" />
  <project path="packages/apps/SetupWizard" name="packages_apps_SetupWizard" remote="halcyon" />
  <project path="packages/apps/ThemePicker" name="packages_apps_ThemePicker" remote="bloom" />
  <project path="packages/apps/TouchGestures" name="packages_apps_TouchGestures" remote="bloom" />
  <project path="packages/inputmethods/LatinIME" name="packages_inputmethods_LatinIME" remote="bloom" />

  <!-- Packages Services -->
  <project path="packages/services/SmartSpace" name="packages_services_SmartSpace" remote="halcyon" />

  <!-- Packages Modules -->
  <project path="packages/modules/Bluetooth" name="packages_modules_Bluetooth" remote="bloom" />
  <project path="packages/modules/Connectivity" name="packages_modules_Connectivity" remote="halcyon-gitlab" />

  <!-- System -->
  <project path="system/bpf" name="system_bpf" remote="bloom" />
  <project path="system/core" name="system_core" remote="bloom" />
  <project path="system/libhidl" name="system_libhidl" remote="bloom" />
  <project path="system/libhwbinder" name="system_libhwbinder" remote="bloom" />
  <project path="system/security" name="system_security" remote="bloom" />
  <project path="system/sepolicy" name="system_sepolicy" remote="bloom" />
  <project path="system/update_engine" name="system_update_engine" remote="bloom" />
  <project path="system/vold" name="system_vold" remote="bloom" />

  <!-- Vendor -->
  <project path="vendor/halcyon" name="vendor_halcyon" remote="bloom" />
  <project path="vendor/halcyonui" name="vendor_halcyonui" remote="bloom"/>

</manifest>
